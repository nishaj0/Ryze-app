generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String?
  gender           String?
  goal             String?
  experienceLevel  String?
  daysAvailable    Int?
  equipmentAccess  String?
  sleepHours       Float?
  dateOfBirth      DateTime?
  currentWeight    Float?
  height           Float?
  units            String   @default("kg")
  onboardingDone   Boolean  @default(false)
  pushToken        String?
  reminderTime     String?  @default("08:00")
  weeklyCheckin    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userSplits       UserSplit[]
  workoutSessions  WorkoutSession[]
  bodyMetrics      BodyMetric[]
  progressPhotos   ProgressPhoto[]
  personalRecords  PersonalRecord[]
  notifications    Notification[]
  createdSplits    Split[]
  nutritionLogs    DailyNutrition[]
  exerciseRequests ExerciseRequest[]
  supportTickets   SupportTicket[]
}

model Split {
  id           String   @id @default(cuid())
  name         String
  description  String?
  type         String
  daysPerWeek  Int
  isPrebuilt   Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())

  createdBy    User?          @relation(fields: [createdById], references: [id])
  days         SplitDay[]
  userSplits   UserSplit[]
}

model SplitDay {
  id           String   @id @default(cuid())
  splitId      String
  dayNumber    Int
  name         String
  muscleGroups String
  isRest       Boolean  @default(false)

  split        Split              @relation(fields: [splitId], references: [id], onDelete: Cascade)
  exercises    SplitDayExercise[]
  sessions     WorkoutSession[]
}

model Exercise {
  id           String   @id @default(cuid())
  name         String   @unique
  force        String?
  level        String?
  mechanic     String?
  equipment    String?
  category     String?
  instructions String?
  createdAt    DateTime @default(now())

  muscles           ExerciseMuscle[]
  images            ExerciseImage[]
  splitDayExercises SplitDayExercise[]
  exerciseLogs      ExerciseLog[]
  alternativesFrom  ExerciseAlternative[] @relation("fromExercise")
  alternativesTo    ExerciseAlternative[] @relation("toExercise")
  personalRecords   PersonalRecord[]
}

model Muscle {
  id        String   @id @default(cuid())
  name      String   @unique
  exercises ExerciseMuscle[]
}

model ExerciseMuscle {
  id         String   @id @default(cuid())
  exerciseId String
  muscleId   String
  isPrimary  Boolean

  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle     Muscle   @relation(fields: [muscleId], references: [id])

  @@unique([exerciseId, muscleId])
}

model ExerciseImage {
  id         String   @id @default(cuid())
  exerciseId String
  url        String
  publicId   String
  order      Int

  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model ExerciseAlternative {
  id             String @id @default(cuid())
  exerciseId     String
  alternativeId  String
  reason         String

  exercise       Exercise @relation("fromExercise", fields: [exerciseId], references: [id], onDelete: Cascade)
  alternative    Exercise @relation("toExercise", fields: [alternativeId], references: [id], onDelete: Cascade)
}

model SplitDayExercise {
  id             String  @id @default(cuid())
  splitDayId     String
  exerciseId     String
  order          Int
  targetSets     Int
  targetRepsMin  Int
  targetRepsMax  Int
  notes          String?

  splitDay       SplitDay @relation(fields: [splitDayId], references: [id], onDelete: Cascade)
  exercise       Exercise @relation(fields: [exerciseId], references: [id])
}

model UserSplit {
  id        String   @id @default(cuid())
  userId    String
  splitId   String
  startDate DateTime @default(now())
  isActive  Boolean  @default(true)
  phase     String?

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  split     Split @relation(fields: [splitId], references: [id], onDelete: Cascade)
}

model WorkoutSession {
  id              String   @id @default(cuid())
  userId          String
  splitDayId      String
  date            DateTime @default(now())
  status          String   @default("IN_PROGRESS")
  restReason      String?
  notes           String?
  durationMinutes Int?
  createdAt       DateTime @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  splitDay       SplitDay      @relation(fields: [splitDayId], references: [id])
  exerciseLogs   ExerciseLog[]
}

model ExerciseLog {
  id          String @id @default(cuid())
  sessionId   String
  exerciseId  String
  order       Int
  notes       String?

  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])
  setLogs     SetLog[]
}

model SetLog {
  id            String   @id @default(cuid())
  exerciseLogId String
  setNumber     Int
  weightKg      Float
  reps          Int
  rpe           Float?
  notes         String?
  completedAt   DateTime @default(now())

  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
}

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  weightKg  Float
  notes     String?
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressPhoto {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime @default(now())
  cloudinaryUrl      String
  cloudinaryPublicId String?
  type               String
  notes              String?
  createdAt          DateTime @default(now())

  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PersonalRecord {
  id           String   @id @default(cuid())
  userId       String
  exerciseId   String
  weightKg     Float
  reps         Int
  estimated1rm Float
  achievedAt   DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
}

model Notification {
  id      String    @id @default(cuid())
  userId  String
  type    String
  title   String
  body    String
  sentAt  DateTime  @default(now())
  readAt  DateTime?

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyNutrition {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  calories  Int?
  proteinG  Int?
  notes     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ExerciseRequest {
  id               String   @id @default(cuid())
  name             String
  description      String?
  force            String?
  level            String?
  mechanic         String?
  equipment        String?
  category         String?
  instructions     String?
  primaryMuscles   String?
  secondaryMuscles String?
  referenceImages  String?
  status           String   @default("PENDING")
  adminNotes       String?
  requestedById    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requestedBy      User?    @relation(fields: [requestedById], references: [id])
}

model AppSettings {
  id                      String   @id @default("default")
  bugReportingEnabled     Boolean  @default(true)
  helpRequestsEnabled     Boolean  @default(true)
  exerciseRequestsEnabled Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model SupportTicket {
  id            String   @id @default(cuid())
  userId        String
  type          String   // BUG, HELP, EXERCISE_REQUEST
  title         String
  description   String
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  adminResponse String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

