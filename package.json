{
  "name": "ryze",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "api:dev": "npm run dev --prefix api",
    "api:build": "npm run build --prefix api",
    "api:db:migrate": "npm run prisma:migrate --prefix api",
    "api:db:seed": "npm run prisma:seed --prefix api",
    "api:db:studio": "npm run prisma:studio --prefix api",
    "api:test": "npm run test --prefix api",
    "app:start": "npm start --prefix expo-app",
    "app:tunnel": "npm run start --prefix expo-app -- --tunnel",
    "app:android": "npm run android --prefix expo-app",
    "app:ios": "npm run ios --prefix expo-app",
    "app:test": "npm run test --prefix expo-app",
    "cpanel:dev": "npm run dev --prefix cpanel",
    "cpanel:build": "npm run build --prefix cpanel",
    "test": "npm run api:test && npm run app:test",
    "dev": "concurrently \"npm run api:dev\" \"npm run app:start\"",
    "dev:all": "concurrently \"npm run api:dev\" \"npm run app:start\" \"npm run cpanel:dev\"",
    "setup": "npm install && npm install --prefix api && npm install --prefix expo-app && npm install --prefix cpanel"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
